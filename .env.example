# Провайдер синтеза: elevenlabs или mock (тестовый тон, без API)
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=your_key_here
# eleven_v4 понимает теги эмоций: [whispers], [pause], [curious]...
ELEVENLABS_MODEL=eleven_v4
# Избранные голоса (id через запятую): Mark Rubins, Nikolay, Daniel, Brian
FAVORITE_VOICES=LmV7j80HF5QYSKe3sDtR,3EuKHIEZbSzrHGNmdYsx,onwK4e9ZLuTAKqWW03F9,nPczCjzI2devNBz1zQrb
DEFAULT_VOICE_ID=
# Максимальное ускорение реплики, чтобы уложиться в тайминг субтитра
MAX_SPEEDUP=1.35
DATA_DIR=data
